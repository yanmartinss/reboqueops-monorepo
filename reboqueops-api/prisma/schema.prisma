// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  services    Service[]
  customers   Customer[]
  invitations Invitation[]
}

enum Role {
  OWNER
  MEMBER
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  role         Role     @default(MEMBER)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitations Invitation[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  services Service[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  PAY_LATER
}

model Service {
  id            String        @id @default(uuid())
  tenantId      String
  customerId    String
  carPlate      String
  origin        String?
  destination   String?
  valueCents    Int
  paymentMethod PaymentMethod
  serviceDate   DateTime
  paymentDate   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, serviceDate])
  @@index([customerId])
}

model Invitation {
  id         String    @id @default(uuid())
  tenantId   String
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  invitedBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedByUser User   @relation(fields: [invitedBy, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId])
}
